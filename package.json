{
  "name": "devsetgo",
  "version": "1.1.0",
  "description": "Interactive developer playground and documentation engine — converts source code, OpenAPI schemas, and Markdown into browser playgrounds and CRO-optimized docs.",
  "type": "module",
  "bin": {
    "devsetgo": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "developer-tools",
    "documentation",
    "playground",
    "webassembly",
    "cli",
    "readme-generator",
    "devrel",
    "cro",
    "devsetgo"
  ],
  "author": "Abdullah Bilal <abdullahbilal-y@github.com>",
  "license": "MIT",
  "dependencies": {
    "@apidevtools/swagger-parser": "^10.1.0",
    "@inquirer/prompts": "^7.5.0",
    "@mermaid-js/mermaid-cli": "^11.4.0",
    "commander": "^13.1.0",
    "glob": "^11.0.0",
    "gray-matter": "^4.0.3",
    "handlebars": "^4.7.8",
    "marked": "^15.0.0",
    "picocolors": "^1.1.0",
    "quickjs-emscripten": "^0.31.0",
    "sharp": "^0.33.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}