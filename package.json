{
  "name": "devsetgo",
  "version": "2.0.0",
  "description": "Interactive developer playground and documentation engine \u2014 converts source code, OpenAPI schemas, and Markdown into browser playgrounds and CRO-optimized docs.",
  "type": "module",
  "bin": {
    "devsetgo": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "npm run clean && tsup",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "developer-tools",
    "documentation",
    "playground",
    "webassembly",
    "cli",
    "readme-generator",
    "devrel",
    "cro",
    "devsetgo"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abdullahbilal-y/devsetgo.git"
  },
  "bugs": {
    "url": "https://github.com/abdullahbilal-y/devsetgo/issues"
  },
  "homepage": "https://github.com/abdullahbilal-y/devsetgo#readme",
  "author": "Abdullah Bilal <abdullahbilal-y@github.com>",
  "license": "MIT",
  "dependencies": {
    "@apidevtools/swagger-parser": "^10.1.0",
    "@inquirer/prompts": "^7.5.0",
    "commander": "^13.1.0",
    "glob": "^11.0.0",
    "gray-matter": "^4.0.3",
    "handlebars": "^4.7.8",
    "marked": "^15.0.0",
    "picocolors": "^1.1.0",
    "typescript": "^5.7.0",
    "yaml": "^2.7.0"
  },
  "optionalDependencies": {
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.1.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.0",
    "typescript-eslint": "^8.19.0",
    "vitest": "^3.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
